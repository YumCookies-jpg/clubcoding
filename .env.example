# Copy to .env (never commit real values)

# --- Mobile (passed with --dart-define) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Admin (Vite, prefix required) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Supabase Edge Functions (server-side only) ---
# Service role key: server-only. NEVER ship to mobile/admin.
SUPABASE_SERVICE_ROLE_KEY=
# NASA FIRMS API key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Firebase Cloud Messaging HTTP v1 (service account)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
